{
  "openapi": "3.0.0",
  "paths": {
    "/v1/caller": {
      "get": {
        "operationId": "getCaller",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallerResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request was refused, or it failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Who the caller is",
        "tags": ["Caller"]
      }
    },
    "/v1/status": {
      "get": {
        "operationId": "getStatus",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request was refused, or it failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [],
        "summary": "When this API process started",
        "tags": ["Status"]
      }
    },
    "/v1/categories": {
      "get": {
        "operationId": "readCategories",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CategoryResponse"
                  }
                }
              }
            }
          },
          "default": {
            "description": "The request was refused, or it failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "The eight Categories, each with its specification list",
        "tags": ["Category"]
      }
    },
    "/v1/parts": {
      "post": {
        "operationId": "createPart",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePartRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request was refused, or it failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Add a Part to the catalog",
        "tags": ["Part"]
      }
    },
    "/v1/parts/{partId}": {
      "get": {
        "operationId": "readPart",
        "parameters": [
          {
            "name": "partId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request was refused, or it failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "One Part of the catalog",
        "tags": ["Part"]
      }
    }
  },
  "info": {
    "title": "Platform API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SubErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "What went wrong, as a fixed code.",
            "example": "ACCESS_DENIED"
          },
          "title": {
            "type": "string",
            "description": "The key of a short text for the error.",
            "example": "access_denied_title"
          },
          "detail": {
            "type": "string",
            "description": "The key of a longer text for the error.",
            "example": "access_denied_details"
          },
          "additionalInformation": {
            "type": "object",
            "description": "Fixed keys and values about the error, such as the field it is about.",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "field": "manufacturer"
            }
          }
        },
        "required": ["code", "title", "detail"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubErrorResponse"
            }
          }
        },
        "required": ["errors"]
      },
      "CallerResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The login's identifier in the identity service.",
            "example": "4d2c1f8e-9a53-4b61-8f0e-2d7c6a1b3e90"
          },
          "loginName": {
            "type": "string",
            "description": "The login's name.",
            "example": "development-admin"
          },
          "roles": {
            "type": "array",
            "description": "The platform roles the login holds.",
            "example": ["admin"],
            "items": {
              "type": "string",
              "enum": ["admin", "vendor"]
            }
          }
        },
        "required": ["id", "loginName", "roles"]
      },
      "StatusResponse": {
        "type": "object",
        "properties": {
          "startedAt": {
            "type": "string",
            "description": "The time this API process started.",
            "format": "date-time",
            "example": "2026-10-09T14:53:40.719Z"
          }
        },
        "required": ["startedAt"]
      },
      "SpecificationResponse": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "The specification's place in a Part's specifications, in OpenDB's field names and nesting. For a field of a row, its name in the row.",
            "example": "specifications.memory.types"
          },
          "label": {
            "type": "string",
            "description": "The specification's English label.",
            "example": "Memory types"
          },
          "kind": {
            "type": "string",
            "description": "The kind of value it holds.",
            "enum": [
              "wholeNumber",
              "decimalNumber",
              "text",
              "yesNo",
              "oneOf",
              "severalOf",
              "listOfText",
              "listOfRows"
            ],
            "example": "severalOf"
          },
          "unit": {
            "type": "string",
            "description": "The unit of a number.",
            "example": "W"
          },
          "values": {
            "description": "The fixed set, for one or several of a fixed set.",
            "example": ["DDR3", "DDR4", "DDR5"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fields": {
            "description": "The fields of each row, for a list of rows.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpecificationResponse"
            }
          },
          "needed": {
            "type": "boolean",
            "description": "Whether a Compatibility Rule reads it.",
            "example": true
          },
          "zeroMeansMissing": {
            "type": "boolean",
            "description": "Whether 0 cannot be true for it, so that 0 stands for \"not known\".",
            "example": false
          }
        },
        "required": ["path", "label", "kind", "needed", "zeroMeansMissing"]
      },
      "CategoryResponse": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "The Category's key, which `i18n`'s shared terms translate it by.",
            "enum": [
              "cpu",
              "cpuCooler",
              "motherboard",
              "ram",
              "storage",
              "gpu",
              "case",
              "psu"
            ],
            "example": "cpu"
          },
          "specifications": {
            "description": "Every specification a Part of this Category can hold, in order.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpecificationResponse"
            }
          }
        },
        "required": ["key", "specifications"]
      },
      "CreatePartRequest": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "The Part's Category, which never changes afterwards.",
            "enum": [
              "cpu",
              "cpuCooler",
              "motherboard",
              "ram",
              "storage",
              "gpu",
              "case",
              "psu"
            ],
            "example": "cpu"
          },
          "name": {
            "type": "string",
            "description": "The Part's name.",
            "example": "AMD Ryzen 5 7600"
          },
          "manufacturer": {
            "type": "string",
            "description": "The Part's manufacturer.",
            "example": "AMD"
          },
          "partNumbers": {
            "description": "The manufacturer's part numbers. None is given as an empty list.",
            "example": ["100-100001015BOX"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "specifications": {
            "type": "object",
            "description": "The Part's specifications, in OpenDB's field names and nesting. Its Category's specification list says what they may hold. Left out, the Part has none.",
            "additionalProperties": true,
            "example": {
              "socket": "AM5",
              "specifications": {
                "tdp": 65,
                "memory": {
                  "types": ["DDR5"]
                }
              }
            }
          }
        },
        "required": ["category", "name", "manufacturer"]
      },
      "PartResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The Part's identifier on the platform.",
            "example": "3b8f0c52-6a1e-4f3d-9c27-5e8a1d4b7f60"
          },
          "category": {
            "type": "string",
            "description": "The Part's Category.",
            "enum": [
              "cpu",
              "cpuCooler",
              "motherboard",
              "ram",
              "storage",
              "gpu",
              "case",
              "psu"
            ],
            "example": "cpu"
          },
          "name": {
            "type": "string",
            "description": "The Part's name.",
            "example": "AMD Ryzen 5 7600"
          },
          "manufacturer": {
            "type": "string",
            "description": "The Part's manufacturer.",
            "example": "AMD"
          },
          "partNumbers": {
            "description": "The manufacturer's part numbers.",
            "example": ["100-100001015BOX"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "openDbId": {
            "type": "string",
            "description": "The Part's identifier in OpenDB, or null for a Part the Admin created.",
            "nullable": true,
            "example": null
          },
          "specifications": {
            "type": "object",
            "description": "The Part's specifications, in OpenDB's field names and nesting. Its Category's specification list says what they may hold.",
            "additionalProperties": true,
            "example": {
              "socket": "AM5",
              "specifications": {
                "tdp": 65,
                "memory": {
                  "types": ["DDR5"]
                }
              }
            }
          },
          "missingNeededSpecifications": {
            "description": "The paths of the specifications a Compatibility Rule reads that the Part lacks, in its list's order.",
            "example": ["specifications.tdp"],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "category",
          "name",
          "manufacturer",
          "partNumbers",
          "openDbId",
          "specifications",
          "missingNeededSpecifications"
        ]
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}
