{
  "openapi": "3.0.0",
  "paths": {
    "/v1/caller": {
      "get": {
        "operationId": "getCaller",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallerResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request was refused, or it failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Who the caller is",
        "tags": ["Caller"]
      }
    },
    "/v1/status": {
      "get": {
        "operationId": "getStatus",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request was refused, or it failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [],
        "summary": "When this API process started",
        "tags": ["Status"]
      }
    },
    "/v1/parts": {
      "post": {
        "operationId": "createPart",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePartRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request was refused, or it failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Add a Part to the catalog",
        "tags": ["Part"]
      }
    },
    "/v1/parts/{partId}": {
      "get": {
        "operationId": "readPart",
        "parameters": [
          {
            "name": "partId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request was refused, or it failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "One Part of the catalog",
        "tags": ["Part"]
      }
    }
  },
  "info": {
    "title": "Platform API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SubErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "What went wrong, as a fixed code.",
            "example": "ACCESS_DENIED"
          },
          "title": {
            "type": "string",
            "description": "The key of a short text for the error.",
            "example": "access_denied_title"
          },
          "detail": {
            "type": "string",
            "description": "The key of a longer text for the error.",
            "example": "access_denied_details"
          },
          "additionalInformation": {
            "type": "object",
            "description": "Fixed keys and values about the error, such as the field it is about.",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "field": "manufacturer"
            }
          }
        },
        "required": ["code", "title", "detail"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubErrorResponse"
            }
          }
        },
        "required": ["errors"]
      },
      "CallerResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The login's identifier in the identity service.",
            "example": "4d2c1f8e-9a53-4b61-8f0e-2d7c6a1b3e90"
          },
          "loginName": {
            "type": "string",
            "description": "The login's name.",
            "example": "development-admin"
          },
          "roles": {
            "type": "array",
            "description": "The platform roles the login holds.",
            "example": ["admin"],
            "items": {
              "type": "string",
              "enum": ["admin", "vendor"]
            }
          }
        },
        "required": ["id", "loginName", "roles"]
      },
      "StatusResponse": {
        "type": "object",
        "properties": {
          "startedAt": {
            "type": "string",
            "description": "The time this API process started.",
            "format": "date-time",
            "example": "2026-10-09T14:53:40.719Z"
          }
        },
        "required": ["startedAt"]
      },
      "CreatePartRequest": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "The Part's Category, which never changes afterwards.",
            "enum": [
              "cpu",
              "cpuCooler",
              "motherboard",
              "ram",
              "storage",
              "gpu",
              "case",
              "psu"
            ],
            "example": "cpu"
          },
          "name": {
            "type": "string",
            "description": "The Part's name.",
            "example": "AMD Ryzen 5 7600"
          },
          "manufacturer": {
            "type": "string",
            "description": "The Part's manufacturer.",
            "example": "AMD"
          },
          "partNumbers": {
            "description": "The manufacturer's part numbers. None is given as an empty list.",
            "example": ["100-100001015BOX"],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["category", "name", "manufacturer"]
      },
      "PartResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The Part's identifier on the platform.",
            "example": "3b8f0c52-6a1e-4f3d-9c27-5e8a1d4b7f60"
          },
          "category": {
            "type": "string",
            "description": "The Part's Category.",
            "enum": [
              "cpu",
              "cpuCooler",
              "motherboard",
              "ram",
              "storage",
              "gpu",
              "case",
              "psu"
            ],
            "example": "cpu"
          },
          "name": {
            "type": "string",
            "description": "The Part's name.",
            "example": "AMD Ryzen 5 7600"
          },
          "manufacturer": {
            "type": "string",
            "description": "The Part's manufacturer.",
            "example": "AMD"
          },
          "partNumbers": {
            "description": "The manufacturer's part numbers.",
            "example": ["100-100001015BOX"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "openDbId": {
            "type": "string",
            "description": "The Part's identifier in OpenDB, or null for a Part the Admin created.",
            "nullable": true,
            "example": null
          }
        },
        "required": ["id", "category", "name", "manufacturer", "partNumbers", "openDbId"]
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}
