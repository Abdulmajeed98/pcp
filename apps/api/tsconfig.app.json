{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/app",
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "out-tsc/app/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "paths": {
      "~/*": ["./src/app/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["out-tsc", "dist", "jest.config.cts", "src/test/**/*.ts"],
  "references": [
    {
      "path": "../../libs/core/tsconfig.lib.json"
    },
    {
      "path": "../../libs/compatibility/tsconfig.lib.json"
    }
  ]
}
