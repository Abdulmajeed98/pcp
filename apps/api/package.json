{
  "name": "@pcp/api",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.7",
    "@pcp/compatibility": "workspace:*",
    "@pcp/core": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "drizzle-orm": "~0.45.4",
    "effect": "^3.22.2",
    "nestjs-cls": "^7.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "~0.31.11"
  },
  "nx": {
    "tags": [
      "scope:api",
      "type:app"
    ],
    "targets": {
      "integration": {
        "executor": "nx:run-commands",
        "options": {
          "command": "jest --config jest.integration.config.cts --runInBand --verbose --reporters=default",
          "cwd": "{projectRoot}"
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@pcp/api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@pcp/api:build:development"
          },
          "production": {
            "buildTarget": "@pcp/api:build:production"
          }
        }
      }
    }
  }
}
