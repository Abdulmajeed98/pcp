{
  "name": "@pcp/api",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@pcp/compatibility": "workspace:*",
    "@pcp/core": "workspace:*",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0"
  },
  "nx": {
    "tags": [
      "scope:api",
      "type:app"
    ],
    "targets": {
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@pcp/api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@pcp/api:build:development"
          },
          "production": {
            "buildTarget": "@pcp/api:build:production"
          }
        }
      }
    }
  }
}
