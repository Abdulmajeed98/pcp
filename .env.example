# The settings that the development services in compose.yaml need, listed
# without their values. `pnpm services:up` creates `.env` from this list on
# the first start and fills every value in. Git ignores `.env`.

# Password of PostgreSQL's own superuser, `postgres`.
POSTGRES_PASSWORD=

# Password of `pcp`, the database user that owns the platform's database.
PCP_DB_PASSWORD=

# Password of `keycloak`, the database user that owns Keycloak's database.
KEYCLOAK_DB_PASSWORD=

# Name and password of Keycloak's own administrator account, which opens
# Keycloak's console during development. It is not the platform's Admin.
KEYCLOAK_ADMINISTRATOR_NAME=
KEYCLOAK_ADMINISTRATOR_PASSWORD=

# Secret of `pcp-api`, the API's own client in the `pcp` realm, whose service
# account manages the realm's Logins. Keycloak gives it to the client when it
# imports the realm, and the API reads it as KEYCLOAK_CLIENT_SECRET.
PCP_API_CLIENT_SECRET=

# Name and password of the development Admin, a login in the `pcp` realm.
# `pnpm services:up` creates it, with the platform's `admin` role, so that
# the Admin console can be logged in to during development.
DEVELOPMENT_ADMIN_NAME=
DEVELOPMENT_ADMIN_PASSWORD=
