{
  "realm": "pcp",
  "enabled": true,
  "displayName": "Platform",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "internationalizationEnabled": true,
  "supportedLocales": ["ckb", "ar", "en"],
  "defaultLocale": "ckb",
  "loginTheme": "pcp",
  "accountTheme": "pcp",
  "emailTheme": "pcp",
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "The Admin: the platform's operator."
      },
      {
        "name": "vendor",
        "description": "A Vendor: a business that shows its Offers on the platform."
      }
    ]
  },
  "clients": [
    {
      "clientId": "dashboard",
      "name": "Dashboard",
      "description": "The login client of the dashboard, which holds the Vendor portal and the Admin console.",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3002/*"],
      "webOrigins": ["http://localhost:3002"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3002/*"
      },
      "protocolMappers": [
        {
          "name": "pcp-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "pcp-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "pcp-api",
      "name": "API",
      "description": "The API's own client, whose service account manages the realm's Logins. Its secret is filled in from the environment when the realm is imported.",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${PCP_API_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-pcp-api",
      "enabled": true,
      "serviceAccountClientId": "pcp-api",
      "clientRoles": {
        "realm-management": ["manage-users"]
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
