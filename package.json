{
  "name": "@pcp/source",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "preinstall": "node tools/require-pnpm.mjs",
    "check": "oxfmt --check && node tools/write-feature-sliced-bans.mjs --check && node tools/write-api-client.mjs --check && oxlint --config .oxlintrc.outside-projects.json --ignore-pattern apps --ignore-pattern libs && nx run-many --targets=lint,typecheck,test,build",
    "format": "oxfmt",
    "services:up": "node tools/start-services.mjs",
    "services:down": "node tools/stop-services.mjs",
    "services:reset": "node tools/stop-services.mjs --delete-data",
    "services:check": "node tools/check-services.mjs",
    "boundaries:check": "node tools/check-boundaries.mjs",
    "boundaries:write": "node tools/write-feature-sliced-bans.mjs",
    "api-client:write": "node tools/write-api-client.mjs",
    "platform:check": "node tools/check-platform.mjs"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.8.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "jose": "^6.2.12",
    "keycloak-js": "^26.2.4",
    "nestjs-cls": "^7.0.1",
    "next": "~16.4.0",
    "next-intl": "^4.14.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@jest/globals": "~30.3.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/jest": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/nest": "23.2.1",
    "@nx/next": "23.2.1",
    "@nx/node": "23.2.1",
    "@nx/oxlint": "23.2.1",
    "@nx/playwright": "23.2.1",
    "@nx/react": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/webpack": "23.2.1",
    "@playwright/test": "^1.64.0",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.8",
    "@swc/helpers": "~0.5.18",
    "@swc/jest": "~0.2.38",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jest": "~30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jiti": "2.4.2",
    "nx": "23.2.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tailwindcss": "1.14.0",
    "supports-color": "7.2.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=24 <25",
      "onFail": "error"
    }
  }
}
